{
  "name": "harbor",
  "version": "3.15.0",
  "description": "Harbor \u2014 secure local file access and local AI for Wave OS",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win nsis msi",
    "build:portable": "electron-builder --win portable",
    "check:scope": "node scripts/check-renderer-scope.js",
    "check:ipc-scope": "node scripts/check-ipc-scope.js",
    "check:handlers": "node scripts/check-handlers.js"
  },
  "build": {
    "appId": "io.oswave.harbor",
    "productName": "Harbor",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "electron": "^30.5.1"
  },
  "author": {
    "name": "xBuildy",
    "email": "info@xbuildy.com"
  },
  "license": "UNLICENSED"
}
